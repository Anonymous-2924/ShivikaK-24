# Copy to .env and fill in. .env is gitignored.

# --- Neo4j (local via docker compose) -----------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_phase1

# --- Qdrant (local via docker compose) ----------------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=      # only needed if you point at a hosted Qdrant

# --- Ollama: embeddings run LOCALLY, extraction runs on OLLAMA CLOUD ----
# These are intentionally two separate hosts.
OLLAMA_EMBED_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIM=1024          # VERIFY with `ollama show bge-m3` before building the Qdrant collection

OLLAMA_CLOUD_HOST=https://ollama.com
OLLAMA_CLOUD_API_KEY=          # fill in with your Ollama Cloud key
OLLAMA_EXTRACT_MODEL=          # pick after `ollama list` on Cloud, e.g. llama3.1:70b or qwen2.5:72b
OLLAMA_VERIFY_MODEL=           # optional stronger verifier model

# --- Behavior toggles (consumed by src/, defaults safe) -----------------
EXTRACTION_SELF_CONSISTENCY=false   # true doubles LLM cost; see Phase 4
TABLE_EXTRACTION_CONFIDENCE_FLOOR=0.75
VERIFIER_SAMPLE_RATE=0.1

# ============================================================
# FinSight AI — environment configuration (copy to .env)
# Never commit your real .env. Secrets are never logged or shown in full.
# ============================================================

# ---- Ollama Cloud (LLM generation) ----
# Create a key for your account; verify the current endpoint in Ollama's docs.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=4
OLLAMA_CONCURRENCY=1

# ---- Embeddings ----
# local  = sentence-transformers (all-MiniLM-L6-v2), CPU, ~80MB one-time download
# ollama = cloud embeddings (if your model supports it)
# hashing = dependency-free fallback (no download; weaker semantics)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# ---- Vector store (Qdrant) ----
# local  = embedded, on-disk (no server, no Docker)
# server = connect to a running Qdrant (set QDRANT_URL)
QDRANT_MODE=local
QDRANT_PATH=data/qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=finsight_reports

# ---- Retrieval / chunking ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=8
HYBRID_ENABLED=true
RERANK_ENABLED=false

# ---- Resources (16 GB defaults) ----
LIGHTWEIGHT_MODE=true
MAX_PARSE_WORKERS=1
MAX_DOWNLOAD_MB=200
DOWNLOAD_TIMEOUT_SECONDS=60

# ---- Logging ----
LOG_LEVEL=INFO
CACHE_ENABLED=true
